            "state": "translated",
            "value": "Impossibile avviare Pilothouse: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseを起動できませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse를 시작할 수 없습니다: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
