    "Pilothouse is up to date": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse ist auf dem neuesten Stand"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse está actualizado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse est à jour"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse è aggiornato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseは最新です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse가 최신 버전입니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse está atualizado"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse güncel"
          }
        },
        "zh-Hans": {
          "stringUnit": {
