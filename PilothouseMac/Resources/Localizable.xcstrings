    "A revoked device is disconnected at once and has to pair again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein widerrufenes Gerät wird sofort getrennt und muss erneut gekoppelt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo revocado se desconecta de inmediato y tiene que volver a vincularse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un appareil révoqué est déconnecté immédiatement et doit être jumelé à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un dispositivo revocato viene disconnesso subito e deve essere abbinato di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消したデバイスはすぐに接続が切断され、再度ペアリングが必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "철회된 기기는 즉시 연결이 해제되며 다시 페어링해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dispositivo revogado é desconectado na hora e precisa ser emparelhado novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edilen bir cihazın bağlantısı hemen kesilir ve yeniden eşleştirilmesi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被撤销的设备会立即断开连接，并需要重新配对。"
          }
        }
      }
    },
