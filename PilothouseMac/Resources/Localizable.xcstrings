    "Install TestFlight if asked, then tap Install for Pilothouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere TestFlight, falls gefragt, und tippe dann bei Pilothouse auf Installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala TestFlight si te lo pide y toca Instalar en Pilothouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez TestFlight si demandé, puis touchez Installer pour Pilothouse."
          }
        },
