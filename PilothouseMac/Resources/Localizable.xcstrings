    "Allow the Pilothouse helper in Login Items…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse-Hilfsprogramm in den Anmeldeobjekten erlauben …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse yardımcısına Giriş Öğeleri'nde izin verin…"
          }
        }
      }
    },
    "Allow “Bypass permissions” mode": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modus „Berechtigungen umgehen“ erlauben"
          }
