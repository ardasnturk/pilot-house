    "General": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Allgemein"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel"
          }
        }
      }
    },
    "Get Tailscale from the App Store and sign in with the same account. iOS does not allow apps to do this for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Tailscale aus dem App Store und melde dich mit demselben Konto an. iOS erlaubt Apps nicht, das für dich zu erledigen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale'i App Store'dan edinin ve aynı hesapla giriş yapın. iOS, uygulamaların bunu sizin yerinize yapmasına izin vermez."
          }
        }
      }
    },
    "Hide Manual Steps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuelle Schritte ausblenden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuel Adımları Gizle"
          }
        }
      }
    },
    "Identity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identität"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik"
          }
        }
      }
    },
    "Idle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşta"
          }
        }
      }
    },
    "In the Tailscale admin console under DNS, enable MagicDNS so your Mac gets a stable name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in der Tailscale-Admin-Konsole unter DNS MagicDNS, damit dein Mac einen stabilen Namen erhält."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizin kalıcı bir adı olması için Tailscale yönetim konsolunda DNS altında MagicDNS'i etkinleştirin."
          }
        }
      }
    },
    "Install Claude Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code installieren"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code'u kurun"
          }
        }
      }
    },
    "Install Claude Code first to let Claude do the setup, or follow the manual steps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere zuerst Claude Code, damit Claude die Einrichtung übernimmt, oder folge den manuellen Schritten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulumu Claude'a yaptırmak için önce Claude Code'u kurun veya manuel adımları izleyin."
          }
        }
      }
    },
    "Install Tailscale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale installieren"
          }
        },
