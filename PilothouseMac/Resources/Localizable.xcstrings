    "Claude Code default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Code-Standard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code varsayılanı"
          }
        }
      }
    },
    "Claude Code is not installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist nicht installiert"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code kurulu değil"
          }
        }
      }
    },
    "Claude Code is not installed on this Mac. Install it, run `claude` once in Terminal to sign in, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf diesem Mac nicht installiert. Installiere es, führe einmal `claude` im Terminal aus, um dich anzumelden, und versuche es erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code bu Mac'te kurulu değil. Kurun, giriş yapmak için Terminal'de bir kez `claude` çalıştırın ve tekrar deneyin."
          }
        }
      }
    },
    "Claude Code is not signed in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist nicht angemeldet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code'a giriş yapılmamış"
          }
        }
      }
    },
    "Claude installs Tailscale from an official source and stops whenever your password or a browser sign-in is needed. Every command needs your approval.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude installiert Tailscale aus einer offiziellen Quelle und hält an, sobald dein Passwort oder eine Anmeldung im Browser nötig ist. Jeder Befehl braucht deine Freigabe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Tailscale'i resmi bir kaynaktan kurar ve şifreniz ya da tarayıcıda giriş gerektiğinde durur. Her komut onayınızı gerektirir."
          }
        }
      }
    },
    "Claude is setting up Tailscale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude richtet Tailscale ein"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Tailscale'i kuruyor"
          }
        }
