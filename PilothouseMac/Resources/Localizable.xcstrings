      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identität"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimlik"
          }
        }
      }
    },
    "Idle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
