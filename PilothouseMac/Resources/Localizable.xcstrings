    "Get Pilothouse for iPhone and iPad": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse für iPhone und iPad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ve iPad için Pilothouse'u edinin"
          }
        }
      }
    },
    "Get Tailscale from the App Store and sign in with the same account. iOS does not allow apps to do this for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Tailscale aus dem App Store und melde dich mit demselben Konto an. iOS erlaubt Apps nicht, das für dich zu erledigen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale'i App Store'dan edinin ve aynı hesapla giriş yapın. iOS, uygulamaların bunu sizin yerinize yapmasına izin vermez."
          }
        }
      }
    },
    "Get notified when a task you started from your phone finishes, when Claude waits for your approval, or when a session fails.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich benachrichtigen, wenn eine vom Telefon gestartete Aufgabe fertig ist, Claude auf deine Freigabe wartet oder eine Sitzung fehlschlägt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan başlattığınız bir görev bittiğinde, Claude onayınızı beklediğinde ya da bir oturum hata verdiğinde bildirim alın."
          }
        }
      }
    },
    "Get the iPhone App": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-App laden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Uygulamasını Edinin"
          }
        }
      }
    },
    "Get the iPhone App…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-App laden …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone Uygulamasını Edinin…"
          }
        }
      }
    },
    "Get the iPhone app": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-App laden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone uygulamasını edinin"
          }
        }
      }
    },
    "GitHub is limiting update checks right now. Try again in an hour.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub begrenzt Update-Prüfungen gerade. Versuche es in einer Stunde erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub şu anda güncelleme kontrollerini sınırlıyor. Bir saat sonra tekrar deneyin."
          }
        }
      }
    },
    "GitHub returned an error while downloading the update. Try again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat beim Laden des Updates einen Fehler gemeldet. Versuche es später erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme indirilirken GitHub bir hata döndürdü. Daha sonra tekrar deneyin."
          }
        }
      }
    },
