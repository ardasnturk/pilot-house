    "At home or in the office you need nothing else: your iPhone talks to this Mac directly over the Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Hause oder im Büro brauchst du nichts weiter: Dein iPhone spricht direkt über das WLAN mit diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En casa o en la oficina no necesitas nada más: tu iPhone se comunica directamente con este Mac por Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À la maison ou au bureau, rien d’autre n’est nécessaire : votre iPhone communique directement avec ce Mac via le Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A casa o in ufficio non ti serve altro: il tuo iPhone comunica direttamente con questo Mac tramite Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自宅やオフィスでは、ほかに何も必要ありません。iPhoneはWi-Fi経由でこのMacと直接通信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "집이나 사무실에서는 다른 것이 필요하지 않습니다. iPhone이 Wi-Fi를 통해 이 Mac과 직접 통신합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em casa ou no escritório, você não precisa de mais nada: seu iPhone fala diretamente com este Mac pela rede Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde veya ofiste başka bir şeye gerek yok: iPhone'unuz bu Mac'le doğrudan Wi-Fi üzerinden konuşur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在家或在办公室时无需其他设置：你的 iPhone 会通过无线局域网直接与这台 Mac 通信。"
          }
        }
      }
    },
