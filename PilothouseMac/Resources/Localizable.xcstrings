    "Claude Code is not installed on this Mac. Install it, run `claude` once in Terminal to sign in, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf diesem Mac nicht installiert. Installiere es, führe einmal `claude` im Terminal aus, um dich anzumelden, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code no está instalado en este Mac. Instálalo, ejecuta `claude` una vez en Terminal para iniciar sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code n’est pas installé sur ce Mac. Installez-le, exécutez `claude` une fois dans Terminal pour vous connecter, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code non è installato su questo Mac. Installalo, esegui `claude` una volta nel Terminale per accedere, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude CodeはこのMacにインストールされていません。インストールしてターミナルで一度`claude`を実行してサインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 Claude Code가 설치되어 있지 않습니다. 설치한 다음 터미널에서 `claude`를 한 번 실행하여 로그인하고 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Code não está instalado neste Mac. Instale-o, execute `claude` uma vez no Terminal para iniciar a sessão e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code bu Mac'te kurulu değil. Kurun, giriş yapmak için Terminal'de bir kez `claude` çalıştırın ve tekrar deneyin."
          }
        },
        "zh-Hans": {
