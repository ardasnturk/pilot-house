    "Claude Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        }
      }
    },
    "Claude Code default": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude-Code-Standard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code varsayılanı"
          }
        }
      }
    },
    "Claude Code gets a delegate_to_agent tool for these agents. Every delegation and every action of the sub-agent still needs your approval, and you can follow it live on your phone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code erhält für diese Agenten ein Werkzeug delegate_to_agent. Jede Übergabe und jede Aktion des Sub-Agents braucht weiterhin deine Zustimmung, und du kannst sie live auf deinem Telefon verfolgen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code bu ajanlar için bir delegate_to_agent aracı alır. Her devir ve alt ajanın her işlemi yine onayınızı gerektirir; telefonunuzdan canlı izleyebilirsiniz."
          }
        }
      }
    },
    "Claude Code is not installed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist nicht installiert"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code kurulu değil"
          }
        }
      }
    },
    "Claude Code is not installed on this Mac. Install it, run `claude` once in Terminal to sign in, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf diesem Mac nicht installiert. Installiere es, führe einmal `claude` im Terminal aus, um dich anzumelden, und versuche es erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code bu Mac'te kurulu değil. Kurun, giriş yapmak için Terminal'de bir kez `claude` çalıştırın ve tekrar deneyin."
          }
        }
      }
    },
    "Claude Code is not signed in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist nicht angemeldet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code'a giriş yapılmamış"
          }
        }
