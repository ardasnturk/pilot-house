    "Written summaries are turned off in Pilothouse settings on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geschriebene Rückblicke sind in den Pilothouse-Einstellungen auf deinem Mac ausgeschaltet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resúmenes escritos están desactivados en los ajustes de Pilothouse en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résumés rédigés sont désactivés dans les réglages de Pilothouse sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I riepiloghi scritti sono disattivati nelle impostazioni di Pilothouse sul tuo Mac."
          }
        },
        "ja": {
