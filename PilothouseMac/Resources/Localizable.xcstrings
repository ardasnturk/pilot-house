            "state": "translated",
            "value": "Manuel Adımları Gizle"
          }
        }
      }
    },
    "How do I get the iPhone app?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie bekomme ich die iPhone-App?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone uygulamasını nasıl edinirim?"
          }
        }
      }
    },
    "How it works": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So funktioniert's"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl çalışır"
          }
        }
      }
    },
