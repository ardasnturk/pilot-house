    "iPhone notifications go through an ntfy server, because iOS only wakes apps through Apple's push service, which would need a Pilothouse server. Tapping one opens the session in Pilothouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-Mitteilungen laufen über einen ntfy-Server, weil iOS Apps nur über Apples Push-Dienst weckt, der einen Pilothouse-Server bräuchte. Ein Tippen darauf öffnet die Sitzung in Pilothouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones del iPhone pasan por un servidor ntfy, porque iOS solo activa las apps mediante el servicio push de Apple, que requeriría un servidor de Pilothouse. Al tocar una, se abre la sesión en Pilothouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications iPhone passent par un serveur ntfy, car iOS ne réveille les apps que via le service push d’Apple, qui nécessiterait un serveur Pilothouse. Toucher une notification ouvre la session dans Pilothouse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le notifiche per iPhone passano da un server ntfy, perché iOS riattiva le app solo tramite il servizio push di Apple, che richiederebbe un server Pilothouse. Toccandone una si apre la sessione in Pilothouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSはAppleのプッシュサービス経由でしかアプリを起動できず、それにはPilothouseのサーバが必要になるため、iPhoneへの通知はntfyサーバを経由します。通知をタップするとPilothouseでセッションが開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS는 Apple의 푸시 서비스를 통해서만 앱을 깨우며 이를 위해서는 Pilothouse 서버가 필요하기 때문에, iPhone 알림은 ntfy 서버를 거칩니다. 알림을 탭하면 Pilothouse에서 세션이 열립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As notificações do iPhone passam por um servidor ntfy, porque o iOS só ativa apps pelo serviço de push da Apple, o que exigiria um servidor do Pilothouse. Tocar em uma delas abre a sessão no Pilothouse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone bildirimleri bir ntfy sunucusu üzerinden gider; çünkü iOS uygulamaları yalnızca Apple'ın push servisiyle uyandırır ve bu bir Pilothouse sunucusu gerektirirdi. Bildirime dokunmak oturumu Pilothouse'da açar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 通知通过 ntfy 服务器发送，因为 iOS 只能通过 Apple 的推送服务唤醒 App，而这需要一台 Pilothouse 服务器。轻点通知即可在 Pilothouse 中打开该会话。"
          }
        }
      }
    },
    "macOS Gatekeeper rejected the update. Nothing was installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper hat das Update abgelehnt. Es wurde nichts installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper de macOS ha rechazado la actualización. No se ha instalado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper de macOS a refusé la mise à jour. Rien n’a été installé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gatekeeper di macOS ha rifiutato l’aggiornamento. Non è stato installato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSのGatekeeperがアップデートを拒否しました。何もインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper가 업데이트를 거부했습니다. 아무것도 설치되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Gatekeeper do macOS rejeitou a atualização. Nada foi instalado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper güncellemeyi reddetti. Hiçbir şey kurulmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Gatekeeper 拒绝了此更新。未安装任何内容。"
          }
        }
      }
    },
