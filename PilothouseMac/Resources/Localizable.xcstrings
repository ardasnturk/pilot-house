    "Start Tailscale from Applications, allow its VPN configuration when macOS asks, then log in from its menu bar icon.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte Tailscale aus dem Programme-Ordner, erlaube die VPN-Konfiguration, wenn macOS fragt, und melde dich über das Menüleistensymbol an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Tailscale desde Aplicaciones, permite su configuración de VPN cuando macOS lo pida e inicia sesión desde su icono en la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez Tailscale depuis Applications, autorisez sa configuration VPN lorsque macOS le demande, puis connectez-vous depuis son icône dans la barre des menus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia Tailscale da Applicazioni, consenti la sua configurazione VPN quando macOS lo chiede, poi accedi dalla sua icona nella barra dei menu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アプリケーション」からTailscaleを起動し、macOSに求められたらVPN構成を許可して、メニューバーのアイコンからログインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응용 프로그램에서 Tailscale을 시작하고 macOS에서 요청하면 VPN 구성을 허용한 다음 메뉴 막대 아이콘에서 로그인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o Tailscale pela pasta Aplicativos, permita a configuração de VPN quando o macOS pedir e depois inicie a sessão pelo ícone na barra de menus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale'i Uygulamalar'dan başlatın, macOS sorduğunda VPN yapılandırmasına izin verin, ardından menü çubuğu simgesinden giriş yapın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“应用程序”中启动 Tailscale，在 macOS 询问时允许其 VPN 配置，然后通过其菜单栏图标登录。"
          }
        }
      }
    },
    "Start a chat from your iPhone or iPad. It runs here on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte einen Chat auf deinem iPhone oder iPad. Er läuft hier auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia un chat desde tu iPhone o iPad. Se ejecuta aquí, en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une discussion depuis votre iPhone ou iPad. Elle s’exécute ici, sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia una chat dal tuo iPhone o iPad. Viene eseguita qui, sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneまたはiPadからチャットを開始します。実行はこのMacで行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 또는 iPad에서 채팅을 시작하십시오. 채팅은 여기 Mac에서 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma conversa pelo seu iPhone ou iPad. Ela é executada aqui no seu Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone veya iPad'inizden bir sohbet başlatın. Burada, Mac'inizde çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 iPhone 或 iPad 开始聊天。它会在这台 Mac 上运行。"
          }
        }
      }
    },
    "Start at login, keep your Mac awake, session history.": {
