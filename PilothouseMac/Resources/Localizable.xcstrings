        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MagicDNSがオフです。固定の名前を使うにはTailscale管理コンソールでオンにしてください（オプション）。"
          }
        },
        "ko": {
          "stringUnit": {
