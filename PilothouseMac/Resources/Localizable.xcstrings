    "Pilothouse can't replace itself in its current location. The download page has been opened in your browser.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse kann sich an seinem aktuellen Ort nicht selbst ersetzen. Die Download-Seite wurde in deinem Browser geöffnet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse no puede reemplazarse a sí mismo en su ubicación actual. Se ha abierto la página de descarga en tu navegador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse ne peut pas se remplacer à son emplacement actuel. La page de téléchargement a été ouverte dans votre navigateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse non può sostituirsi nella posizione attuale. La pagina di download è stata aperta nel browser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseは現在の場所では自身を置き換えられません。ブラウザでダウンロードページを開きました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse가 현재 위치에서 자신을 교체할 수 없습니다. 브라우저에서 다운로드 페이지가 열렸습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse não pode se substituir no local atual. A página de download foi aberta no seu navegador."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse bulunduğu konumda kendini değiştiremiyor. İndirme sayfası tarayıcınızda açıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 无法在当前位置替换自身。已在浏览器中打开下载页面。"
          }
        }
      }
    },
    "Pilothouse could not start: %@": {
      "localizations": {
        "de": {
