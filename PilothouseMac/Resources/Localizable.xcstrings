        }
      }
    },
    "Claude installs Tailscale from an official source and stops whenever your password or a browser sign-in is needed. Every command needs your approval.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude installiert Tailscale aus einer offiziellen Quelle und hält an, sobald dein Passwort oder eine Anmeldung im Browser nötig ist. Jeder Befehl braucht deine Freigabe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude instala Tailscale desde una fuente oficial y se detiene cada vez que se necesita tu contraseña o un inicio de sesión en el navegador. Cada comando necesita tu aprobación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude installe Tailscale depuis une source officielle et s’arrête chaque fois que votre mot de passe ou une connexion dans le navigateur est nécessaire. Chaque commande nécessite votre approbation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude installa Tailscale da una fonte ufficiale e si ferma ogni volta che servono la tua password o un accesso dal browser. Ogni comando richiede la tua approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeは公式のソースからTailscaleをインストールし、パスワードやブラウザでのサインインが必要になるたびに停止します。すべてのコマンドにあなたの承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude는 공식 소스에서 Tailscale을 설치하며 암호나 브라우저 로그인이 필요할 때마다 멈춥니다. 모든 명령에는 승인이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude instala o Tailscale de uma fonte oficial e para sempre que sua senha ou um início de sessão no navegador for necessário. Cada comando precisa da sua aprovação."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Tailscale'i resmi bir kaynaktan kurar ve şifreniz ya da tarayıcıda giriş gerektiğinde durur. Her komut onayınızı gerektirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 会从官方来源安装 Tailscale，并在需要你的密码或浏览器登录时暂停。每条命令都需要你的批准。"
          }
        }
      }
    },
