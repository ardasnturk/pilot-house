    "MagicDNS is off. Turn it on in the Tailscale admin console for a stable name (optional).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MagicDNS ist aus. Aktiviere es in der Tailscale-Admin-Konsole für einen stabilen Namen (optional)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MagicDNS está desactivado. Actívalo en la consola de administración de Tailscale para tener un nombre estable (opcional)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MagicDNS est désactivé. Activez-le dans la console d’administration Tailscale pour avoir un nom stable (facultatif)."
          }
        },
        "it": {
          "stringUnit": {
