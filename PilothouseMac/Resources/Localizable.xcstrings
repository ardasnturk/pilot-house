{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not installed on this Mac. Install it, sign in once in Terminal, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf diesem Mac nicht installiert. Installiere es, melde dich einmal im Terminal an und versuche es erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu Mac'te kurulu değil. Kurun, Terminal'de bir kez giriş yapın ve tekrar deneyin."
          }
        }
      }
    },
    "%@ is paired": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist gekoppelt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eşleştirildi"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld d": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld T"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld g"
          }
        }
      }
    },
    "%lld h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Std."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sa"
          }
        }
      }
    },
    "5 h": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Std."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 sa"
          }
        }
      }
    },
    "A revoked device is disconnected at once and has to pair again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein widerrufenes Gerät wird sofort getrennt und muss erneut gekoppelt werden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edilen bir cihazın bağlantısı hemen kesilir ve yeniden eşleştirilmesi gerekir."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "API-Schlüssel"
          }
        },
        "tr": {
