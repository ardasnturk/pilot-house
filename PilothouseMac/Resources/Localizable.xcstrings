    "Takes effect after restarting Pilothouse. The next free port is used if it is taken.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach einem Neustart von Pilothouse wirksam. Ist der Port belegt, wird der nächste freie verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al reiniciar Pilothouse. Si el puerto está ocupado, se usa el siguiente libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prend effet après le redémarrage de Pilothouse. Si le port est occupé, le port libre suivant est utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha effetto dopo il riavvio di Pilothouse. Se la porta è occupata, viene usata la successiva libera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseを再起動すると有効になります。ポートが使用中の場合は、次の空いているポートが使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse를 재시작한 후에 적용됩니다. 포트가 사용 중이면 다음 사용 가능한 포트를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entra em vigor após reiniciar o Pilothouse. Se a porta estiver ocupada, a próxima porta livre será usada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse yeniden başlatıldıktan sonra geçerli olur. Port doluysa bir sonraki boş port kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 Pilothouse 后生效。如果端口已被占用，将使用下一个空闲端口。"
          }
        }
      }
    },
