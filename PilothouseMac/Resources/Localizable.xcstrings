    "Get Tailscale from the App Store and sign in with the same account. iOS does not allow apps to do this for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Tailscale aus dem App Store und melde dich mit demselben Konto an. iOS erlaubt Apps nicht, das für dich zu erledigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga Tailscale del App Store e inicia sesión con la misma cuenta. iOS no permite que las apps lo hagan por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez Tailscale sur l’App Store et connectez-vous avec le même compte. iOS ne permet pas aux apps de le faire à votre place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica Tailscale dall’App Store e accedi con lo stesso account. iOS non consente alle app di farlo per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App StoreからTailscaleを入手し、同じアカウントでサインインします。iOSではアプリがこの操作を代わりに行うことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 Tailscale을 받고 같은 계정으로 로그인하십시오. iOS에서는 앱이 이를 대신 수행할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha o Tailscale na App Store e inicie a sessão com a mesma conta. O iOS não permite que os apps façam isso por você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale'i App Store'dan edinin ve aynı hesapla giriş yapın. iOS, uygulamaların bunu sizin yerinize yapmasına izin vermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 App Store 获取 Tailscale，并使用同一账户登录。iOS 不允许 App 替你完成此操作。"
          }
        }
      }
    },
    "Get notified when a task you started from your phone finishes, when Claude waits for your approval, or when a session fails.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dich benachrichtigen, wenn eine vom Telefon gestartete Aufgabe fertig ist, Claude auf deine Freigabe wartet oder eine Sitzung fehlschlägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe un aviso cuando termine una tarea que iniciaste desde el teléfono, cuando Claude espere tu aprobación o cuando falle una sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez averti quand une tâche lancée depuis votre téléphone se termine, quand Claude attend votre approbation ou quand une session échoue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una notifica quando un’attività avviata dal telefono termina, quando Claude attende la tua approvazione o quando una sessione non riesce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneから開始したタスクが完了したとき、Claudeが承認を待っているとき、またはセッションが失敗したときに通知を受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰에서 시작한 작업이 끝나거나, Claude가 승인을 기다리거나, 세션이 실패하면 알림을 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba notificações quando uma tarefa iniciada pelo celular terminar, quando o Claude aguardar sua aprovação ou quando uma sessão falhar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefondan başlattığınız bir görev bittiğinde, Claude onayınızı beklediğinde ya da bir oturum hata verdiğinde bildirim alın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当你从手机启动的任务完成、Claude 等待你的批准或会话失败时收到通知。"
          }
        }
      }
    },
