    "Scan the code with your iPhone's camera to install the app with TestFlight, Apple's free app for beta apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code mit der Kamera deines iPhones, um die App mit TestFlight zu installieren, Apples kostenloser App für Beta-Apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea el código con la cámara del iPhone para instalar la app con TestFlight, la app gratuita de Apple para apps beta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez le code avec l’appareil photo de votre iPhone pour installer l’app avec TestFlight, l’app gratuite d’Apple pour les apps bêta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona il codice con la fotocamera dell’iPhone per installare l’app con TestFlight, l’app gratuita di Apple per le app beta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneのカメラでコードをスキャンし、ベータ版アプリ用のAppleの無料アプリTestFlightでインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 카메라로 코드를 스캔하여 베타 앱용 Apple의 무료 앱인 TestFlight로 앱을 설치하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneie o código com a câmera do seu iPhone para instalar o app com o TestFlight, o app gratuito da Apple para apps beta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı Apple'ın beta uygulamaları için ücretsiz uygulaması TestFlight ile kurmak için kodu iPhone kameranızla okutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 iPhone 的相机扫描代码，通过 TestFlight（Apple 用于 Beta 版 App 的免费 App）安装此 App。"
          }
        }
      }
    },
    "Scan the code, or open the link on your iPhone or iPad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code oder öffne den Link auf deinem iPhone oder iPad."
          }
        },
