    "Lid-closed mode is on. Keep your Mac ventilated; it can get warm in a bag.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modus bei geschlossenem Deckel ist aktiv. Sorge für Belüftung; in einer Tasche kann der Mac warm werden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalı modu açık. Mac'inizin havalanmasını sağlayın; çantada ısınabilir."
          }
        }
      }
    },
    "Local network": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokales Netzwerk"
          }
        },
        "tr": {
