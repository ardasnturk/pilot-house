    },
    "Tailscale is installed, but its command-line tool was not found. Open Tailscale once, or enable its CLI in Tailscale's settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist installiert, aber das Befehlszeilenwerkzeug wurde nicht gefunden. Öffne Tailscale einmal oder aktiviere die CLI in den Tailscale-Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale está instalado, pero no se ha encontrado su herramienta de línea de comandos. Abre Tailscale una vez o activa su CLI en los ajustes de Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale est installé, mais son outil en ligne de commande est introuvable. Ouvrez Tailscale une fois, ou activez sa CLI dans les réglages de Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale è installato, ma il suo strumento da riga di comando non è stato trovato. Apri Tailscale una volta o attiva la sua CLI nelle impostazioni di Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscaleはインストールされていますが、コマンドラインツールが見つかりませんでした。Tailscaleを一度開くか、Tailscaleの設定でCLIを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale이 설치되어 있지만 명령어 도구를 찾을 수 없습니다. Tailscale을 한 번 열거나 Tailscale 설정에서 CLI를 활성화하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Tailscale está instalado, mas a ferramenta de linha de comando dele não foi encontrada. Abra o Tailscale uma vez ou ative a CLI dele nos ajustes do Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale kurulu ancak komut satırı aracı bulunamadı. Tailscale'i bir kez açın veya ayarlarından CLI'ını etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 已安装，但未找到其命令行工具。请打开一次 Tailscale，或在 Tailscale 的设置中启用其 CLI。"
          }
        }
      }
    },
    "Tailscale is not installed on this Mac.": {
      "localizations": {
