    "Create a new random topic. Phones subscribed to the old one stop receiving notifications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt ein neues zufälliges Thema. Telefone, die das alte abonniert haben, erhalten keine Mitteilungen mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un tema aleatorio nuevo. Los teléfonos suscritos al anterior dejarán de recibir notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Crée un nouveau sujet aléatoire. Les téléphones abonnés à l’ancien ne recevront plus de notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuovo argomento casuale. I telefoni iscritti a quello vecchio smetteranno di ricevere notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいランダムなトピックを作成します。古いトピックを購読しているiPhoneには通知が届かなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 무작위 토픽을 생성합니다. 이전 토픽을 구독한 휴대폰은 더 이상 알림을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um novo tópico aleatório. Os celulares inscritos no tópico antigo deixam de receber notificações."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir rastgele konu oluşturur. Eski konuya abone olan telefonlara artık bildirim gelmez."
