{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not installed on this Mac. Install it, sign in once in Terminal, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf diesem Mac nicht installiert. Installiere es, melde dich einmal im Terminal an und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está instalado en este Mac. Instálalo, inicia sesión una vez en Terminal y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas installé sur ce Mac. Installez-le, connectez-vous une fois dans Terminal, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è installato su questo Mac. Installalo, accedi una volta nel Terminale, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのMacにインストールされていません。インストールしてターミナルで一度サインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 %@이(가) 설치되어 있지 않습니다. 설치하고 터미널에서 한 번 로그인한 다음 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não está instalado neste Mac. Instale-o, inicie a sessão uma vez no Terminal e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu Mac'te kurulu değil. Kurun, Terminal'de bir kez giriş yapın ve tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上未安装 %@。请安装它，在“终端”中登录一次，然后重试。"
          }
        }
      }
    },
    "%@ is paired": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist gekoppelt"
          }
        },
        "es": {
