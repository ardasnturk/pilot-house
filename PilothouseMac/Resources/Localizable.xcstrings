    "On-device summaries need macOS 26 or later on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Rückblicke auf dem Gerät brauchen macOS 26 oder neuer auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resúmenes en el dispositivo necesitan macOS 26 o posterior en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résumés sur l’appareil nécessitent macOS 26 ou version ultérieure sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I riepiloghi sul dispositivo richiedono macOS 26 o versioni successive sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス上での概要作成には、MacにmacOS 26以降が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 내 요약을 사용하려면 Mac에 macOS 26 이상이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resumos no dispositivo exigem o macOS 26 ou posterior no seu Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihaz içi özetler için Mac'inizde macOS 26 veya üstü gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备端摘要需要 Mac 运行 macOS 26 或更高版本。"
          }
        }
      }
    },
