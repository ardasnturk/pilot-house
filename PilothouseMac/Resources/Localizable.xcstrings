    },
    "Paired devices learn this address automatically. On your iPhone or iPad, install Tailscale from the App Store and sign in with the same account — iOS does not let apps do this for you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelte Geräte lernen diese Adresse automatisch. Installiere auf deinem iPhone oder iPad Tailscale aus dem App Store und melde dich mit demselben Konto an – iOS erlaubt Apps nicht, das für dich zu erledigen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos vinculados obtienen esta dirección automáticamente. En tu iPhone o iPad, instala Tailscale desde el App Store e inicia sesión con la misma cuenta: iOS no permite que las apps lo hagan por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils jumelés apprennent cette adresse automatiquement. Sur votre iPhone ou iPad, installez Tailscale depuis l’App Store et connectez-vous avec le même compte — iOS ne permet pas aux apps de le faire à votre place."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi abbinati ricevono questo indirizzo automaticamente. Sul tuo iPhone o iPad, installa Tailscale dall’App Store e accedi con lo stesso account — iOS non consente alle app di farlo per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペアリング済みのデバイスはこのアドレスを自動的に取得します。iPhoneまたはiPadでApp StoreからTailscaleをインストールし、同じアカウントでサインインしてください — iOSではアプリがこの操作を代わりに行うことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페어링된 기기는 이 주소를 자동으로 파악합니다. iPhone 또는 iPad에서 App Store를 통해 Tailscale을 설치하고 같은 계정으로 로그인하십시오 — iOS에서는 앱이 이를 대신 수행할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos emparelhados recebem este endereço automaticamente. No seu iPhone ou iPad, instale o Tailscale pela App Store e inicie a sessão com a mesma conta — o iOS não permite que os apps façam isso por você."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşmiş cihazlar bu adresi otomatik öğrenir. iPhone veya iPad'inizde App Store'dan Tailscale'i kurun ve aynı hesapla giriş yapın — iOS uygulamaların bunu sizin yerinize yapmasına izin vermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已配对的设备会自动获取此地址。在 iPhone 或 iPad 上，从 App Store 安装 Tailscale 并使用同一账户登录 — iOS 不允许 App 替你完成此操作。"
          }
        }
      }
    },
