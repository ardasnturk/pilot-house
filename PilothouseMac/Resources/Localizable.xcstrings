    "The device is disconnected immediately and has to pair again to reconnect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät wird sofort getrennt und muss erneut gekoppelt werden, um sich zu verbinden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El dispositivo se desconecta de inmediato y tiene que volver a vincularse para conectarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil est déconnecté immédiatement et doit être jumelé à nouveau pour se reconnecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il dispositivo viene disconnesso subito e deve essere abbinato di nuovo per riconnettersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスはすぐに切断され、再接続するには再度ペアリングが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 연결이 즉시 해제되며 다시 연결하려면 다시 페어링해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O dispositivo é desconectado imediatamente e precisa ser emparelhado novamente para se reconectar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın bağlantısı hemen kesilir; yeniden bağlanmak için tekrar eşleştirilmesi gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备会立即断开连接，需要重新配对才能再次连接。"
          }
        }
      }
    },
    "The display may still turn off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bildschirm kann sich trotzdem ausschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la pantalla se apague igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’écran peut tout de même s’éteindre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schermo potrebbe comunque spegnersi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイはオフになる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이는 여전히 꺼질 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A tela ainda pode se desligar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran yine de kapanabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示器仍可能关闭。"
          }
        }
      }
    },
    "The downloaded update is damaged (checksum mismatch). Nothing was installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Update ist beschädigt (Prüfsumme stimmt nicht). Es wurde nichts installiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización descargada está dañada (la suma de comprobación no coincide). No se ha instalado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour téléchargée est endommagée (somme de contrôle incorrecte). Rien n’a été installé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’aggiornamento scaricato è danneggiato (checksum non corrispondente). Non è stato installato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードしたアップデートが破損しています（チェックサムの不一致）。何もインストールされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드한 업데이트가 손상되었습니다(체크섬 불일치). 아무것도 설치되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização baixada está danificada (checksum não corresponde). Nada foi instalado."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirilen güncelleme bozuk (sağlama toplamı uyuşmuyor). Hiçbir şey kurulmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载的更新已损坏（校验和不匹配）。未安装任何内容。"
          }
        }
      }
    },
    "The helper could not change the sleep setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hilfsprogramm konnte die Ruhezustandseinstellung nicht ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente no ha podido cambiar el ajuste de reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assistant n’a pas pu modifier le réglage de suspension."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’helper non è riuscito a modificare l’impostazione di stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルパーがスリープ設定を変更できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도우미가 잠자기 설정을 변경할 수 없습니다."
          }
        },
        "pt-BR": {
