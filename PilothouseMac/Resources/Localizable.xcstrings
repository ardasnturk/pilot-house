    "Couldn't reach GitHub to check for updates. Check your internet connection and try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub war für die Update-Suche nicht erreichbar. Prüfe deine Internetverbindung und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con GitHub para buscar actualizaciones. Comprueba tu conexión a internet y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre GitHub pour rechercher les mises à jour. Vérifiez votre connexion Internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere GitHub per cercare aggiornamenti. Controlla la connessione a Internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートを確認するためにGitHubに接続できませんでした。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트를 확인하기 위해 GitHub에 연결할 수 없습니다. 인터넷 연결을 확인하고 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar o GitHub para verificar atualizações. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncellemeleri kontrol etmek için GitHub'a ulaşılamadı. İnternet bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接 GitHub 检查更新。请检查你的互联网连接，然后重试。"
          }
