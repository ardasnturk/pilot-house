          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatılıyor"
          }
        }
      }
    },
    "Starting…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlatılıyor…"
          }
        }
      }
    },
    "Stay awake with the lid closed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei geschlossenem Deckel wach bleiben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapak kapalıyken de açık kal"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdur"
          }
        }
      }
    },
    "Stored in Keychain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schlüsselbund gespeichert"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar Zinciri'nde saklanıyor"
          }
        }
      }
    },
    "Tailscale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale"
          }
        }
      }
    },
    "Tailscale IP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale-IP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale IP"
          }
        }
      }
    },
    "Tailscale is connected": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist verbunden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale bağlı"
          }
        }
      }
    },
    "Tailscale is installed but not connected (%@).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist installiert, aber nicht verbunden (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale kurulu ama bağlı değil (%@)."
          }
        }
      }
    },
    "Tailscale is installed, but its command-line tool was not found. Open Tailscale once, or enable its CLI in Tailscale's settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist installiert, aber das Befehlszeilenwerkzeug wurde nicht gefunden. Öffne Tailscale einmal oder aktiviere die CLI in den Tailscale-Einstellungen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale kurulu ancak komut satırı aracı bulunamadı. Tailscale'i bir kez açın veya ayarlarından CLI'ını etkinleştirin."
          }
        }
      }
    },
    "Tailscale is not installed on this Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale ist auf diesem Mac nicht installiert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te Tailscale kurulu değil."
          }
        }
      }
    },
    "Takes effect after restarting Pilothouse. The next free port is used if it is taken.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nach einem Neustart von Pilothouse wirksam. Ist der Port belegt, wird der nächste freie verwendet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse yeniden başlatıldıktan sonra geçerli olur. Port doluysa bir sonraki boş port kullanılır."
          }
        }
      }
    },
    "The API key could not be saved: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der API-Schlüssel konnte nicht gespeichert werden: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtarı kaydedilemedi: %@"
          }
        }
      }
    },
    "The device is disconnected immediately and has to pair again to reconnect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gerät wird sofort getrennt und muss erneut gekoppelt werden, um sich zu verbinden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazın bağlantısı hemen kesilir; yeniden bağlanmak için tekrar eşleştirilmesi gerekir."
          }
        }
      }
    },
    "The helper could not change the sleep setting.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hilfsprogramm konnte die Ruhezustandseinstellung nicht ändern."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı uyku ayarını değiştiremedi."
          }
        }
      }
    },
    "The helper is not available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Hilfsprogramm ist nicht verfügbar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımcı kullanılamıyor."
          }
        }
      }
    },
    "The same code appears on your phone after pairing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Code erscheint nach dem Koppeln auf deinem Telefon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirmeden sonra aynı kod telefonunuzda görünür."
          }
        }
      }
    },
    "Tip: set up Tailscale to reach this Mac away from home.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Richte Tailscale ein, um diesen Mac unterwegs zu erreichen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Bu Mac'e evden uzakta erişmek için Tailscale'i kurun."
          }
        }
      }
    },
    "Traffic between your devices is end-to-end encrypted. Pilothouse never connects to Anthropic and collects no telemetry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datenverkehr zwischen deinen Geräten ist Ende-zu-Ende verschlüsselt. Pilothouse verbindet sich nie mit Anthropic und sammelt keine Telemetrie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazlarınız arasındaki trafik uçtan uca şifrelidir. Pilothouse asla Anthropic'e bağlanmaz ve telemetri toplamaz."
          }
        }
      }
    },
    "Turn on MagicDNS (recommended)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MagicDNS aktivieren (empfohlen)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MagicDNS'i açın (önerilir)"
          }
        }
      }
    },
    "Unknown helper status.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannter Status des Hilfsprogramms."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilinmeyen yardımcı durumu."
          }
        }
      }
    },
    "Use an Anthropic API key instead of the CLI login": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic-API-Schlüssel statt CLI-Anmeldung verwenden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "CLI girişi yerine bir Anthropic API anahtarı kullan"
          }
        }
      }
    },
    "Uses a small privileged helper that only runs `pmset -a disablesleep`. A closed MacBook that stays awake can get warm and drain its battery; the setting is reverted when Pilothouse quits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet ein kleines privilegiertes Hilfsprogramm, das nur `pmset -a disablesleep` ausführt. Ein zugeklapptes MacBook, das wach bleibt, kann warm werden und den Akku leeren; die Einstellung wird beim Beenden von Pilothouse zurückgesetzt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca `pmset -a disablesleep` çalıştıran küçük, yetkili bir yardımcı kullanır. Kapağı kapalıyken uyanık kalan bir MacBook ısınabilir ve pilini tüketebilir; Pilothouse kapanınca ayar geri alınır."
          }
        }
      }
    },
    "Valid for %lld:%@ · single use": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gültig für %lld:%@ · einmalig"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld:%@ geçerli · tek kullanımlık"
          }
        }
      }
    },
    "Verification code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigungscode"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulama kodu"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Version"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürüm"
          }
        }
      }
    },
    "Waiting for approval": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf Freigabe"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay bekleniyor"
          }
        }
      }
    },
    "When allowed, a paired device can start sessions in which Claude edits files and runs commands without asking. Only enable this if you understand the risk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn erlaubt, kann ein gekoppeltes Gerät Sitzungen starten, in denen Claude ohne Nachfrage Dateien ändert und Befehle ausführt. Aktiviere dies nur, wenn du das Risiko verstehst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin verilirse, eşleşmiş bir cihaz Claude'un sormadan dosya düzenleyip komut çalıştırdığı oturumlar başlatabilir. Yalnızca riski anlıyorsanız etkinleştirin."
          }
        }
      }
    },
    "Working": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışıyor"
          }
        }
      }
    },
    "You can also follow and approve this session on your iPhone or iPad.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diese Sitzung auch auf deinem iPhone oder iPad verfolgen und freigeben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumu iPhone veya iPad'inizden de izleyip onaylayabilirsiniz."
          }
        }
      }
    },
    "You can now start Claude Code sessions on this Mac from your device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jetzt von deinem Gerät aus Claude-Code-Sitzungen auf diesem Mac starten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık cihazınızdan bu Mac'te Claude Code oturumları başlatabilirsiniz."
          }
        }
      }
    }
  },
  "version": "1.0"
}
