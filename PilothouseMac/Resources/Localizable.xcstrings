    "Download Tailscale for macOS from tailscale.com, or install it with Homebrew.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Tailscale für macOS von tailscale.com herunter oder installiere es mit Homebrew."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS için Tailscale'i tailscale.com'dan indirin veya Homebrew ile kurun."
          }
        }
      }
    },
    "End session %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung %@ beenden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oturumunu sonlandır"
          }
