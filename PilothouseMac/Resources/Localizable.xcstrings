          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşta"
          }
        }
      }
    },
    "In the Tailscale admin console under DNS, enable MagicDNS so your Mac gets a stable name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in der Tailscale-Admin-Konsole unter DNS MagicDNS, damit dein Mac einen stabilen Namen erhält."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizin kalıcı bir adı olması için Tailscale yönetim konsolunda DNS altında MagicDNS'i etkinleştirin."
          }
        }
      }
    },
    "Include a short summary": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Zusammenfassung hinzufügen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa bir özet ekle"
          }
        }
      }
    },
    "Install Claude Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code installieren"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code'u kurun"
          }
        }
      }
    },
    "Install Claude Code first to let Claude do the setup, or follow the manual steps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere zuerst Claude Code, damit Claude die Einrichtung übernimmt, oder folge den manuellen Schritten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulumu Claude'a yaptırmak için önce Claude Code'u kurun veya manuel adımları izleyin."
          }
        }
      }
    },
    "Install Pilothouse on your iPhone or iPad, then scan a pairing code from this Mac. Both need to be on the same Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere Pilothouse auf deinem iPhone oder iPad und scanne dann einen Kopplungscode von diesem Mac. Beide müssen im selben WLAN sein."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse'u iPhone veya iPad'inize kurun, ardından bu Mac'ten bir eşleştirme kodu tarayın. İkisinin de aynı Wi-Fi'de olması gerekir."
          }
        }
      }
    },
    "Install Tailscale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale installieren"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale'i kurun"
          }
        }
      }
    },
    "Install Tailscale on your iPhone or iPad": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale auf iPhone oder iPad installieren"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone veya iPad'inize Tailscale'i kurun"
          }
        }
      }
    },
    "Install TestFlight if asked, then tap Install for Pilothouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere TestFlight, falls gefragt, und tippe dann bei Pilothouse auf Installieren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstenirse TestFlight'ı yükleyin, ardından Pilothouse için Yükle'ye dokunun."
          }
        }
      }
    },
    "Install and Relaunch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren und neu starten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kur ve Yeniden Başlat"
          }
        }
      }
    },
    "Install new versions of Pilothouse from GitHub.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Versionen von Pilothouse von GitHub installieren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse'un yeni sürümlerini GitHub'dan kurun."
          }
        }
      }
    },
    "Install the free ntfy app, tap +, and enter the topic. For a self-hosted server, also turn on “Use another server” and enter its address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere die kostenlose ntfy-App, tippe auf + und gib das Thema ein. Für einen eigenen Server aktiviere zusätzlich „Use another server“ und gib seine Adresse ein."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ücretsiz ntfy uygulamasını kurun, + simgesine dokunun ve konuyu girin. Kendi sunucunuzu kullanıyorsanız “Use another server” seçeneğini de açıp adresini girin."
          }
        }
      }
    },
    "Installed version": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installierte Version"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu sürüm"
          }
        }
      }
