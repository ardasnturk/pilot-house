    "In the Tailscale admin console under DNS, enable MagicDNS so your Mac gets a stable name.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere in der Tailscale-Admin-Konsole unter DNS MagicDNS, damit dein Mac einen stabilen Namen erhält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la consola de administración de Tailscale, en DNS, activa MagicDNS para que tu Mac tenga un nombre estable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans la console d’administration Tailscale, sous DNS, activez MagicDNS pour que votre Mac ait un nom stable."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella console di amministrazione di Tailscale, in DNS, attiva MagicDNS affinché il tuo Mac abbia un nome stabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale管理コンソールのDNSでMagicDNSを有効にすると、Macに固定の名前が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Tailscale 관리 콘솔의 DNS에서 MagicDNS를 활성화하여 Mac이 고정된 이름을 갖도록 하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No console de administração do Tailscale, em DNS, ative o MagicDNS para que o seu Mac tenha um nome estável."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizin kalıcı bir adı olması için Tailscale yönetim konsolunda DNS altında MagicDNS'i etkinleştirin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Tailscale 管理控制台的 DNS 下启用 MagicDNS，让你的 Mac 获得固定名称。"
          }
        }
      }
    },
