        }
      }
    },
    "Paused while on battery. It resumes on power.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Akkubetrieb pausiert. Wird am Netzteil fortgesetzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En pausa mientras usa la batería. Se reanuda al conectarlo a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suspendu sur batterie. Reprend sur secteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In pausa a batteria. Riprende con l’alimentazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー使用中のため一時停止しています。電源に接続すると再開します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 사용 중에는 일시 정지됩니다. 전원에 연결하면 재개됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausado ao usar a bateria. Retoma quando conectado à energia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pildeyken duraklatıldı. Güce bağlanınca devam eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用电池时已暂停。接通电源后恢复。"
          }
        }
      }
    },
