# Settings for linux/docker-compose.yml. linux/install.sh writes linux/.env for
# you; edit it and run `docker compose -f linux/docker-compose.yml up -d` again.

# --- Folders on the Pi --------------------------------------------------------
# Your projects (shown on the phone as ~/projects).
PROJECTS_DIR=/home/ubuntu/projects
# Home folder of the container: Claude's sign-in, Pilothouse's keys and chats.
PILOTHOUSE_HOME=/home/ubuntu/.pilothouse
# Owner of those folders on the Pi (`id -u`, `id -g`). Changing them needs a rebuild.
PUID=1000
PGID=1000

# --- Image (changing these needs `docker compose build`) ----------------------
# Let Claude use `sudo apt-get install …` inside the container.
ALLOW_SUDO=true
# Extra Ubuntu packages to bake into the image, e.g. "openjdk-17-jdk-headless sqlite3".
EXTRA_APT_PACKAGES=
# Also install Codex and/or Gemini CLI (sign in once with `docker exec -it pilothouse codex`).
INSTALL_CODEX=false
INSTALL_GEMINI=false

# --- Pilothouse ----------------------------------------------------------------
# Name shown on the phone (default: the Pi's host name).
#PILOTHOUSE_NAME=Raspberry Pi
# Port for the phone (default 47823, or the next free one up to 47842).
#PILOTHOUSE_PORT=47823
# LAN address(es) to put into the pairing code, if the detected ones are wrong.
#PILOTHOUSE_ADDRESSES=192.168.1.50
# Tailscale on the Pi: its address is found by itself; MagicDNS name optional.
#PILOTHOUSE_TAILSCALE_IP=100.101.102.103
#PILOTHOUSE_MAGICDNS_NAME=raspberrypi.tail1234.ts.net
# Offer "Bypass permissions" (Claude acts without asking) on the phone.
PILOTHOUSE_ALLOW_BYPASS_PERMISSIONS=false
# Defaults for new chats: a model (opus, sonnet, haiku, …) and the permission
# mode (default, acceptEdits, plan, bypassPermissions).
#PILOTHOUSE_DEFAULT_MODEL=sonnet
#PILOTHOUSE_DEFAULT_PERMISSION_MODE=default
# Days to keep chat logs.
#PILOTHOUSE_RETENTION_DAYS=30
# Agents Claude may hand tasks to (needs INSTALL_CODEX / INSTALL_GEMINI).
#PILOTHOUSE_DELEGATION_AGENTS=codex,gemini

# --- Signing in to Claude --------------------------------------------------------
# Normally you sign in once with `docker exec -it pilothouse claude`. Instead,
# a long-lived token from `claude setup-token` (on any computer) works too:
#CLAUDE_CODE_OAUTH_TOKEN=
# Or an Anthropic API key (billed per use):
#ANTHROPIC_API_KEY=

# --- Notifications through ntfy (https://ntfy.sh) --------------------------------
# Subscribe to the topic in the ntfy iPhone app; the topic acts as a password.
#PILOTHOUSE_NTFY_SERVER=https://ntfy.sh
#PILOTHOUSE_NTFY_TOPIC=pick-a-long-random-topic
#PILOTHOUSE_NTFY_TOKEN=
# Which alerts: turnFinished,permissionRequested,sessionFailed,subagentFinished
#PILOTHOUSE_NOTIFY=turnFinished,permissionRequested,sessionFailed
# Add the last message / tool name to the notification text.
#PILOTHOUSE_NOTIFY_DETAIL=false

# --- Git ---------------------------------------------------------------------------
# Identity for commits Claude makes (until you run `git config --global` yourself).
#GIT_AUTHOR_NAME=Your Name
#GIT_AUTHOR_EMAIL=you@example.com
