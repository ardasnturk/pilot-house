            "state": "translated",
            "value": "Alle"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümü"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver"
          }
        }
      }
    },
    "Always allow %@ in this session": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in dieser Sitzung immer erlauben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumda %@ için hep izin ver"
          }
        }
      }
    },
    "Answer to Claude": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort an Claude"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude'a verilen cevap"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm"
          }
        }
      }
    },
    "Approve or deny file edits and commands with one tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen und Befehle mit einem Tippen erlauben oder ablehnen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya düzenlemelerini ve komutları tek dokunuşla onaylayın ya da reddedin."
          }
        }
      }
    },
    "Ask %@ anything about this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag %@ alles zu diesem Ordner"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörle ilgili %@'e istediğini sor"
          }
        }
      }
    },
    "Ask Claude anything about this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag Claude alles zu diesem Ordner"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörle ilgili Claude'a istediğini sor"
          }
        }
      }
    },
    "Ask every time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal fragen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seferinde sor"
          }
        }
      }
    },
    "At home, Pilothouse talks to your Mac over Wi-Fi. To reach it from anywhere, both devices join your private Tailscale network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Hause spricht Pilothouse über WLAN mit deinem Mac. Um ihn überall zu erreichen, treten beide Geräte deinem privaten Tailscale-Netzwerk bei."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde Pilothouse, Mac'inizle Wi-Fi üzerinden konuşur. Her yerden erişmek için iki cihaz da özel Tailscale ağınıza katılır."
          }
        }
      }
    },
    "Attach photos or videos": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos oder Videos anhängen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğraf veya video ekle"
          }
        }
      }
    },
    "Browse your Mac and start a chat where your project lives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche deinen Mac und starte einen Chat dort, wo dein Projekt liegt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde gezinin ve projenizin bulunduğu yerde bir sohbet başlatın."
          }
        }
      }
    },
    "Built-in": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integriert"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik"
          }
        }
      }
    },
    "Bypass permissions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen umgehen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzinleri atla"
          }
        }
      }
    },
    "Camera viewfinder for the pairing QR code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerasucher für den Kopplungs-QR-Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme QR kodu için kamera vizörü"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Cancelled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi"
          }
        }
      }
    },
    "Chats": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetler"
          }
        }
      }
    },
    "Claude Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        }
      }
    },
    "Claude Code could not find the earlier conversation. Your next message starts a fresh one in this session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code konnte das frühere Gespräch nicht finden. Deine nächste Nachricht startet in dieser Sitzung ein neues."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code önceki konuşmayı bulamadı. Bir sonraki mesajınız bu oturumda yeni bir konuşma başlatır."
          }
        }
      }
    },
    "Claude Code is not signed in on the Mac. Run `claude` in Terminal there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf dem Mac nicht angemeldet. Führe dort im Terminal `claude` aus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te Claude Code'a giriş yapılmamış. Orada Terminal'de `claude` komutunu çalıştırın."
          }
        }
      }
    },
    "Claude Code is not signed in on this Mac. Open Terminal, run `claude` and sign in, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf diesem Mac nicht angemeldet. Öffne das Terminal, führe `claude` aus, melde dich an und versuche es erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te Claude Code'a giriş yapılmamış. Terminal'i açın, `claude` komutunu çalıştırıp giriş yapın ve tekrar deneyin."
          }
        }
      }
    },
    "Claude Code, Codex or Gemini CLI, installed and signed in once in Terminal. The Mac app tells you if something is missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex oder Gemini CLI, installiert und einmal im Terminal angemeldet. Die Mac-App sagt dir, wenn etwas fehlt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code, Codex veya Gemini CLI; kurulu ve Terminal'de bir kez oturum açılmış olmalı. Bir şey eksikse Mac uygulaması size söyler."
          }
        }
      }
    },
    "Claude asks before editing files or running commands.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude fragt, bevor Dateien geändert oder Befehle ausgeführt werden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude dosyaları düzenlemeden veya komut çalıştırmadan önce sorar."
          }
        }
      }
    },
    "Claude edits and runs commands without asking. Use with care.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ändert Dateien und führt Befehle ohne Nachfrage aus. Mit Vorsicht verwenden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sormadan düzenler ve komut çalıştırır. Dikkatli kullanın."
          }
        }
      }
    },
    "Claude kept working on your Mac while you were away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude hat auf deinem Mac weitergearbeitet, während du weg warst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz yokken Claude Mac'inizde çalışmaya devam etti."
          }
        }
      }
    },
    "Claude only reads and plans; it does not change anything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude liest und plant nur; es wird nichts verändert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude yalnızca okur ve plan yapar; hiçbir şeyi değiştirmez."
          }
        }
      }
    },
    "Claude reports its limits with every turn, so they are as fresh as the last answer. Codex limits are read from your Mac when you open this screen. Gemini does not report limits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude meldet seine Limits mit jeder Antwort, sie sind also so aktuell wie die letzte Antwort. Codex-Limits werden beim Öffnen dieses Bildschirms von deinem Mac gelesen. Gemini meldet keine Limits."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude limitlerini her turda bildirir; yani son cevap kadar günceldir. Codex limitleri bu ekranı açtığınızda Mac'inizden okunur. Gemini limit bildirmez."
          }
        }
      }
    },
    "Claude runs on your Mac with Claude Code. You'll see every step here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude läuft mit Claude Code auf deinem Mac. Hier siehst du jeden Schritt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Mac'inizde Claude Code ile çalışır. Her adımı burada görürsünüz."
          }
        }
      }
    },
    "Claude wants to use %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude möchte %@ verwenden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %@ kullanmak istiyor"
          }
        }
      }
    },
