          "stringUnit": {
            "state": "translated",
            "value": "Agent-Standard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan varsayılanı"
          }
        }
      }
    },
    "Agent: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent: %@"
          }
        },
        "tr": {
          "stringUnit": {
