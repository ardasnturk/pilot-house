            "value": "Web araması"
          }
        }
      }
    },
    "Working": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeitet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
