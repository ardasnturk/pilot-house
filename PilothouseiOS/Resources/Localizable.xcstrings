      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent-Standard"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan varsayılanı"
          }
        }
      }
    },
    "Agent: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan: %@"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin Ver"
          }
        }
      }
    },
    "Always allow %@ in this session": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in dieser Sitzung immer erlauben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumda %@ için hep izin ver"
          }
        }
      }
    },
    "An image was too large to send.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Bild war zu groß zum Senden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir görsel gönderilemeyecek kadar büyük."
          }
        }
      }
    },
    "Answer to Claude": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwort an Claude"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude'a verilen cevap"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm"
          }
        }
      }
    },
    "Approve or deny file edits and commands with one tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen und Befehle mit einem Tippen erlauben oder ablehnen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya düzenlemelerini ve komutları tek dokunuşla onaylayın ya da reddedin."
          }
        }
      }
    },
    "Ask %@ anything about this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag %@ alles zu diesem Ordner"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörle ilgili %@'e istediğini sor"
          }
        }
      }
    },
    "Ask Claude anything about this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag Claude alles zu diesem Ordner"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörle ilgili Claude'a istediğini sor"
          }
        }
      }
    },
    "Ask every time": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mal fragen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seferinde sor"
          }
        }
      }
    },
    "At home, Pilothouse talks to your Mac over Wi-Fi. To reach it from anywhere, both devices join your private Tailscale network.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Hause spricht Pilothouse über WLAN mit deinem Mac. Um ihn überall zu erreichen, treten beide Geräte deinem privaten Tailscale-Netzwerk bei."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evde Pilothouse, Mac'inizle Wi-Fi üzerinden konuşur. Her yerden erişmek için iki cihaz da özel Tailscale ağınıza katılır."
          }
        }
      }
    },
    "Attach images": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder anhängen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel ekle"
          }
        }
      }
    },
    "Automatic": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik"
          }
        }
      }
    },
    "Automatic tries the last working address, then your local network, then Tailscale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch versucht zuerst die zuletzt funktionierende Adresse, dann das lokale Netzwerk, dann Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik mod önce son çalışan adresi, sonra yerel ağı, ardından Tailscale'i dener."
          }
        }
      }
    },
    "Away from home? Set up Tailscale": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterwegs? Tailscale einrichten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Evden uzakta mısınız? Tailscale'i kurun"
          }
        }
      }
    },
    "Before you start": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du startest"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamadan önce"
          }
        }
      }
    },
    "Browse your Mac and start a Claude Code session where your project lives.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuche deinen Mac und starte eine Claude-Code-Sitzung dort, wo dein Projekt liegt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inize göz atın ve projenizin bulunduğu yerde bir Claude Code oturumu başlatın."
          }
        }
      }
    },
    "Bypass permissions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berechtigungen umgehen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzinleri atla"
          }
        }
      }
    },
    "Camera viewfinder for the pairing QR code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamerasucher für den Kopplungs-QR-Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleştirme QR kodu için kamera vizörü"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vazgeç"
          }
        }
      }
    },
    "Cancelled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgebrochen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İptal edildi"
          }
        }
      }
    },
    "Claude Code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code"
          }
        }
      }
    },
    "Claude Code could not find the earlier conversation. Your next message starts a fresh one in this session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code konnte das frühere Gespräch nicht finden. Deine nächste Nachricht startet in dieser Sitzung ein neues."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code önceki konuşmayı bulamadı. Bir sonraki mesajınız bu oturumda yeni bir konuşma başlatır."
          }
        }
      }
    },
    "Claude Code is not signed in on the Mac. Run `claude` in Terminal there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf dem Mac nicht angemeldet. Führe dort im Terminal `claude` aus."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te Claude Code'a giriş yapılmamış. Orada Terminal'de `claude` komutunu çalıştırın."
          }
        }
      }
    },
    "Claude Code is not signed in on this Mac. Open Terminal, run `claude` and sign in, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code ist auf diesem Mac nicht angemeldet. Öffne das Terminal, führe `claude` aus, melde dich an und versuche es erneut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te Claude Code'a giriş yapılmamış. Terminal'i açın, `claude` komutunu çalıştırıp giriş yapın ve tekrar deneyin."
          }
        }
      }
    },
    "Claude asks before editing files or running commands.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude fragt, bevor Dateien geändert oder Befehle ausgeführt werden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude dosyaları düzenlemeden veya komut çalıştırmadan önce sorar."
          }
        }
      }
    },
    "Claude edits and runs commands without asking. Use with care.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude ändert Dateien und führt Befehle ohne Nachfrage aus. Mit Vorsicht verwenden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude sormadan düzenler ve komut çalıştırır. Dikkatli kullanın."
          }
        }
      }
    },
    "Claude kept working on your Mac while you were away.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude hat auf deinem Mac weitergearbeitet, während du weg warst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siz yokken Claude Mac'inizde çalışmaya devam etti."
          }
        }
      }
    },
    "Claude only reads and plans; it does not change anything.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude liest und plant nur; es wird nichts verändert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude yalnızca okur ve plan yapar; hiçbir şeyi değiştirmez."
          }
        }
      }
    },
    "Claude runs on your Mac with Claude Code. You'll see every step here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude läuft mit Claude Code auf deinem Mac. Hier siehst du jeden Schritt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Mac'inizde Claude Code ile çalışır. Her adımı burada görürsünüz."
          }
        }
      }
    },
    "Claude wants to use %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude möchte %@ verwenden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude %@ kullanmak istiyor"
          }
        }
      }
    },
