    "If iOS asks for Local Network access, allow it so Pilothouse can find your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn iOS nach Zugriff auf das lokale Netzwerk fragt, erlaube ihn, damit Pilothouse deinen Mac findet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si iOS pide acceso a la red local, permítelo para que Pilothouse pueda encontrar tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si iOS demande l’accès au réseau local, autorisez-le pour que Pilothouse puisse trouver votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se iOS chiede l’accesso alla rete locale, consentilo affinché Pilothouse possa trovare il tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSでローカルネットワークへのアクセスを求められたら、PilothouseがMacを見つけられるように許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS에서 로컬 네트워크 접근을 요청하면 Pilothouse가 Mac을 찾을 수 있도록 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o iOS pedir acesso à Rede Local, permita para que o Pilothouse possa encontrar o seu Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Yerel Ağ erişimi isterse izin verin; böylece Pilothouse Mac'inizi bulabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果 iOS 请求本地网络访问权限，请允许，以便 Pilothouse 找到你的 Mac。"
          }
        }
      }
    },
