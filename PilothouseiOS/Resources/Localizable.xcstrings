    "Make sure Pilothouse is running on your Mac and both devices are on the same Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass Pilothouse auf deinem Mac läuft und beide Geräte im selben WLAN sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que Pilothouse se está ejecutando en tu Mac y de que ambos dispositivos están en la misma Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que Pilothouse est ouvert sur votre Mac et que les deux appareils sont sur le même Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che Pilothouse sia in esecuzione sul tuo Mac e che entrambi i dispositivi siano sulla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでPilothouseが実行中で、両方のデバイスが同じWi-Fiに接続していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Pilothouse가 실행 중이고 두 기기가 같은 Wi-Fi에 연결되어 있는지 확인하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o Pilothouse está em execução no seu Mac e se os dois dispositivos estão na mesma rede Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse'un Mac'inizde çalıştığından ve iki cihazın aynı Wi-Fi'de olduğundan emin olun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保 Mac 上正在运行 Pilothouse，且两台设备连接到同一无线局域网。"
          }
        }
      }
    },
    "Make sure Pilothouse is running on your Mac and both devices are on the same Wi-Fi. Away from that Wi-Fi? Use Tailscale.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achte darauf, dass Pilothouse auf deinem Mac läuft und beide Geräte im selben WLAN sind. Nicht in diesem WLAN? Nutze Tailscale."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que Pilothouse se está ejecutando en tu Mac y de que ambos dispositivos están en la misma Wi-Fi. ¿Lejos de esa Wi-Fi? Usa Tailscale."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que Pilothouse est ouvert sur votre Mac et que les deux appareils sont sur le même Wi-Fi. Loin de ce Wi-Fi ? Utilisez Tailscale."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che Pilothouse sia in esecuzione sul tuo Mac e che entrambi i dispositivi siano sulla stessa rete Wi-Fi. Lontano da quella rete? Usa Tailscale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでPilothouseが実行中で、両方のデバイスが同じWi-Fiに接続していることを確認してください。そのWi-Fiから離れている場合は、Tailscaleを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Pilothouse가 실행 중이고 두 기기가 같은 Wi-Fi에 연결되어 있는지 확인하십시오. 해당 Wi-Fi 밖에 있다면 Tailscale을 사용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se o Pilothouse está em execução no seu Mac e se os dois dispositivos estão na mesma rede Wi-Fi. Longe dessa rede Wi-Fi? Use o Tailscale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse'un Mac'inizde çalıştığından ve iki cihazın aynı Wi-Fi'de olduğundan emin olun. O Wi-Fi'den uzakta mısınız? Tailscale kullanın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保 Mac 上正在运行 Pilothouse，且两台设备连接到同一无线局域网。不在该无线局域网范围内？请使用 Tailscale。"
          }
        }
      }
    },
