        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一条消息能附带的最多图像数量。"
          }
        }
      }
    },
    "The camera is only used to read the pairing code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird nur zum Lesen des Kopplungscodes verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo se usa para leer el código de vinculación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo sert uniquement à lire le code de jumelage."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera viene usata solo per leggere il codice di abbinamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラはペアリングコードの読み取りにのみ使用されます。"
