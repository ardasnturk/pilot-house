{
  "sourceLanguage": "en",
  "strings": {
    "%@ is not signed in on your Mac. Run it once in Terminal there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf deinem Mac nicht angemeldet. Starte es dort einmal im Terminal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde oturum açmamış. Orada Terminal'de bir kez çalıştırın."
          }
        }
      }
    },
    "%@ runs on your Mac. You'll see every step here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft auf deinem Mac. Du siehst hier jeden Schritt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde çalışır. Her adımı burada görürsünüz."
          }
        }
      }
    },
    "%lld image(s)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Bild(er)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld görsel"
          }
        }
      }
    },
    "(no output)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(keine Ausgabe)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "(çıktı yok)"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakkında"
          }
        }
      }
    },
    "Accept edits": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen akzeptieren"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemeleri kabul et"
          }
        }
      }
    },
