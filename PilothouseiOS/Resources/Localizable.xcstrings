    },
    "Waiting for the sub-agent…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warte auf den Sub-Agent …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt ajan bekleniyor…"
          }
        }
      }
    },
    "Waiting for your approval…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf deine Freigabe …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onayınız bekleniyor…"
          }
        }
      }
    },
    "Watch replies, tool calls, file diffs and command output as they happen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge Antworten, Werkzeugaufrufe, Datei-Diffs und Befehlsausgaben in Echtzeit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtları, araç çağrılarını, dosya farklarını ve komut çıktılarını anında izleyin."
          }
        }
      }
    },
