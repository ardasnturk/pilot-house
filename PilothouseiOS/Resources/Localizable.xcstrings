    "That's the most images one message can carry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mehr Bilder passen nicht in eine Nachricht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el máximo de imágenes que puede llevar un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le nombre maximal d’images qu’un message peut contenir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il numero massimo di immagini per un messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1件のメッセージに添付できる画像の上限に達しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
