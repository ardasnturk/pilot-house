    "Download it from the website and open it. A helm icon appears in the menu bar at the top of the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade sie von der Website herunter und öffne sie. Oben auf dem Bildschirm erscheint in der Menüleiste ein Steuerrad-Symbol."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descárgalo desde la web y ábrelo. Aparecerá un icono de timón en la barra de menús, en la parte superior de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléchargez-le depuis le site web et ouvrez-le. Une icône de barre (gouvernail) apparaît dans la barre des menus en haut de l’écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scaricalo dal sito web e aprilo. Nella barra dei menu in alto sullo schermo appare un’icona a forma di timone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webサイトからダウンロードして開きます。画面上部のメニューバーに舵輪のアイコンが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 사이트에서 다운로드하여 여십시오. 화면 상단의 메뉴 막대에 조타륜 아이콘이 나타납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe-o no site e abra-o. Um ícone de leme aparece na barra de menus, na parte superior da tela."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web sitesinden indirip açın. Ekranın üstündeki menü çubuğunda bir dümen simgesi belirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从网站下载并打开。屏幕顶部的菜单栏中会出现舵轮图标。"
          }
        }
      }
    },
