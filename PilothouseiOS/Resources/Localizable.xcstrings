    "Approve or deny file edits and commands with one tap.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateiänderungen und Befehle mit einem Tippen erlauben oder ablehnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprueba o rechaza cambios en archivos y comandos con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuvez ou refusez les modifications de fichiers et les commandes d’un simple toucher."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva o rifiuta modifiche ai file e comandi con un tocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの編集やコマンドをワンタップで承認または拒否できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 탭으로 파일 편집과 명령을 승인하거나 거부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprove ou negue edições de arquivos e comandos com um toque."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya düzenlemelerini ve komutları tek dokunuşla onaylayın ya da reddedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点一下即可批准或拒绝文件编辑和命令。"
          }
        }
      }
    },
    "Ask %@ anything about this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag %@ alles zu diesem Ordner"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a %@ lo que quieras sobre esta carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à %@ tout ce que vous voulez sur ce dossier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi a %@ qualsiasi cosa su questa cartella"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダについて%@に何でも質問"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더에 대해 %@에게 무엇이든 물어보십시오"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte ao %@ qualquer coisa sobre esta pasta"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasörle ilgili %@'e istediğini sor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 %@ 询问有关此文件夹的任何问题"
          }
        }
      }
    },
