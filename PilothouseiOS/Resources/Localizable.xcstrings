    "You can change these when the reply has finished.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst das ändern, sobald die Antwort fertig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar esto cuando termine la respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez les modifier une fois la réponse terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi modificarli quando la risposta è terminata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信が完了したら変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 끝나면 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode alterar isso quando a resposta terminar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunları yanıt bittiğinde değiştirebilirsiniz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复完成后即可更改这些设置。"
          }
        }
      }
    },
