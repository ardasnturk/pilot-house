    "Offline — showing the saved transcript. Claude keeps working on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – der gespeicherte Verlauf wird angezeigt. Claude arbeitet auf deinem Mac weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: se muestra el historial guardado. Claude sigue trabajando en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne — affichage de l’historique enregistré. Claude continue de travailler sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — viene mostrata la cronologia salvata. Claude continua a lavorare sul tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン — 保存されたトランスクリプトを表示しています。ClaudeはMacで作業を続けています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 — 저장된 기록을 표시합니다. Claude는 Mac에서 계속 작업합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — mostrando a transcrição salva. O Claude continua trabalhando no seu Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı — kayıtlı döküm gösteriliyor. Claude Mac'inizde çalışmaya devam ediyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线 — 正在显示已存储的记录。Claude 会继续在你的 Mac 上工作。"
          }
        }
      }
    },
    "On the Mac, click the helm icon, choose “Pair iPhone or iPad…”, then tap the button below and scan the code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf dem Mac auf das Steuerrad-Symbol, wähle „iPhone oder iPad koppeln …“, tippe dann unten auf die Taste und scanne den Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el Mac, haz clic en el icono del timón, elige “Vincular iPhone o iPad…”, toca el botón de abajo y escanea el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur le Mac, cliquez sur l’icône du gouvernail, choisissez “Jumeler un iPhone ou iPad…”, puis touchez le bouton ci-dessous et scannez le code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul Mac, fai clic sull’icona del timone, scegli “Abbina iPhone o iPad…”, poi tocca il pulsante qui sotto e scansiona il codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで舵輪のアイコンをクリックして「iPhoneまたはiPadをペアリング…」を選択し、下のボタンをタップしてコードをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 조타륜 아이콘을 클릭하고 ‘iPhone 또는 iPad 페어링…’을 선택한 다음, 아래 버튼을 탭하고 코드를 스캔하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No Mac, clique no ícone de leme, escolha “Emparelhar iPhone ou iPad…”, depois toque no botão abaixo e escaneie o código."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'te dümen simgesine tıklayın, “iPhone veya iPad Eşleştir…” öğesini seçin, ardından aşağıdaki düğmeye dokunup kodu tarayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上点按舵轮图标，选择“配对 iPhone 或 iPad…”，然后轻点下方按钮并扫描代码。"
          }
        }
      }
    },
    "On this device": {
      "localizations": {
        "de": {
          "stringUnit": {
