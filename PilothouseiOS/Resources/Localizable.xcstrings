    "Watch replies, tool calls, file diffs and command output as they happen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfolge Antworten, Werkzeugaufrufe, Datei-Diffs und Befehlsausgaben in Echtzeit."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtları, araç çağrılarını, dosya farklarını ve komut çıktılarını anında izleyin."
