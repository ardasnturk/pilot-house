    "Add to Favorites": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu Favoriten hinzufügen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favorilere Ekle"
          }
        }
      }
    },
    "Agent default": {
      "localizations": {
