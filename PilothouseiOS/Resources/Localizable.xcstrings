{
  "sourceLanguage": "en",
  "strings": {
    "%@ does not report its commands to Pilothouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meldet seine Befehle nicht an Pilothouse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ komutlarını Pilothouse'a bildirmiyor."
          }
        }
      }
    },
    "%@ is not signed in on your Mac. Run it once in Terminal there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf deinem Mac nicht angemeldet. Starte es dort einmal im Terminal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde oturum açmamış. Orada Terminal'de bir kez çalıştırın."
          }
        }
      }
    },
    "%@ runs on your Mac. You'll see every step here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft auf deinem Mac. Du siehst hier jeden Schritt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde çalışır. Her adımı burada görürsünüz."
          }
        }
      }
    },
    "%@: %lld percent used": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %lld Prozent verbraucht"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %%%lld kullanıldı"
          }
        }
      }
    },
    "%lld days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gün"
          }
        }
      }
    },
    "%lld hours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Stunden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld saat"
          }
        }
      }
    },
    "%lld image(s)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Bild(er)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld görsel"
          }
        }
      }
    },
    "(no output)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(keine Ausgabe)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "(çıktı yok)"
          }
        }
      }
    },
    "5 hours": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "5 Stunden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saat"
          }
        }
      }
    },
