    },
    "Tailscale only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Tailscale"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Tailscale"
          }
        }
      }
    },
    "Tap the compose button to pick a folder on your Mac and start Claude Code there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Schreiben-Taste, um einen Ordner auf deinem Mac zu wählen und dort Claude Code zu starten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde bir klasör seçmek ve orada Claude Code'u başlatmak için oluştur düğmesine dokunun."
          }
        }
      }
    },
    "Task": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgabe"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görev"
          }
        }
      }
    },
    "Tasks": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufgaben"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görevler"
          }
        }
      }
    },
    "The camera is only used to read the pairing code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird nur zum Lesen des Kopplungscodes verwendet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera yalnızca eşleştirme kodunu okumak için kullanılır."
          }
        }
      }
    },
    "The conversation was compacted to free up context.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Gespräch wurde komprimiert, um Kontext freizugeben."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlam alanı açmak için konuşma sıkıştırıldı."
          }
        }
      }
    },
    "The folder is created in %@ on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner wird auf deinem Mac in %@ erstellt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör Mac'inizde %@ içinde oluşturulur."
          }
        }
      }
    },
    "The transcript is removed from your Mac and this device. Files Claude changed are not affected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf wird von deinem Mac und diesem Gerät entfernt. Von Claude geänderte Dateien bleiben unberührt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döküm Mac'inizden ve bu cihazdan silinir. Claude'un değiştirdiği dosyalar etkilenmez."
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denkt nach …"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşünüyor…"
          }
        }
      }
    },
    "Third-party software": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software von Drittanbietern"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçüncü taraf yazılımlar"
          }
        }
      }
    },
    "This Mac": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac"
          }
        }
      }
    },
    "This device forgets the Mac and its cached transcripts. To block this device on the Mac too, revoke it in the Pilothouse menu on the Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät vergisst den Mac und seine zwischengespeicherten Verläufe. Um das Gerät auch auf dem Mac zu sperren, widerrufe es im Pilothouse-Menü auf dem Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz Mac'i ve önbellekteki dökümlerini unutur. Bu cihazı Mac'te de engellemek için Mac'teki Pilothouse menüsünden iptal edin."
          }
        }
      }
    },
    "This folder is empty.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist leer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klasör boş."
          }
        }
      }
    },
    "This is not a valid Pilothouse pairing code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist kein gültiger Pilothouse-Kopplungscode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu geçerli bir Pilothouse eşleştirme kodu değil."
          }
        }
      }
    },
    "This sub-agent left no transcript.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Sub-Agent hat keinen Verlauf hinterlassen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alt ajan bir döküm bırakmadı."
          }
        }
      }
    },
    "Thought": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachgedacht"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düşündü"
          }
        }
      }
    },
    "Three steps": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drei Schritte"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üç adım"
          }
        }
      }
    },
    "Transcripts stay on your Mac and are downloaded again when you open a session.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verläufe bleiben auf deinem Mac und werden beim Öffnen einer Sitzung erneut geladen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dökümler Mac'inizde kalır ve bir oturumu açtığınızda yeniden indirilir."
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut versuchen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar Dene"
          }
        }
