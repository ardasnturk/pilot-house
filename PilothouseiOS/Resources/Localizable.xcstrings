            "state": "translated",
            "value": "Ayrıntıları gösterir"
          }
        }
      }
    },
    "Shows what the sub-agent is doing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt, was der Sub-Agent gerade tut"
