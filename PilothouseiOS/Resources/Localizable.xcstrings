    "On your Mac, click “Copy Link” in the pairing window and paste it here (for example via Universal Clipboard).": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf deinem Mac im Kopplungsfenster auf „Link kopieren“ und füge ihn hier ein (zum Beispiel über die universelle Zwischenablage)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu Mac, haz clic en “Copiar enlace” en la ventana de vinculación y pégalo aquí (por ejemplo, mediante el Portapapeles universal)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre Mac, cliquez sur “Copier le lien” dans la fenêtre de jumelage et collez-le ici (par exemple via le Presse-papiers universel)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sul tuo Mac, fai clic su “Copia link” nella finestra di abbinamento e incollalo qui (ad esempio tramite Appunti universali)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのペアリングウインドウで「リンクをコピー」をクリックし、ここにペーストします（ユニバーサルクリップボードなどを使用）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac의 페어링 윈도우에서 ‘링크 복사’를 클릭하고 여기에 붙여넣으십시오(예: 공통 클립보드 사용)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No seu Mac, clique em “Copiar Link” na janela de emparelhamento e cole aqui (por exemplo, com a Área de Transferência Universal)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde eşleştirme penceresindeki “Bağlantıyı Kopyala”ya tıklayın ve buraya yapıştırın (örneğin Evrensel Pano ile)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的配对窗口中点按“拷贝链接”，然后粘贴到这里（例如通过通用剪贴板）。"
          }
        }
      }
    },
    "Only the first entries are shown.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur die ersten Einträge angezeigt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestran las primeras entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les premières entrées sont affichées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono mostrate solo le prime voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の項目のみ表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "처음 몇 개의 항목만 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas as primeiras entradas são mostradas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ilk girişler gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示前几个条目。"
          }
        }
      }
    },
    "Open Pilothouse on your Mac, choose “Pair New Device…” and point the camera at the QR code.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Pilothouse auf deinem Mac, wähle „Neues Gerät koppeln …“ und richte die Kamera auf den QR-Code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Pilothouse en tu Mac, elige “Vincular nuevo dispositivo…” y apunta la cámara al código QR."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Pilothouse sur votre Mac, choisissez “Jumeler un nouvel appareil…” et pointez l’appareil photo vers le code QR."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Pilothouse sul tuo Mac, scegli “Abbina nuovo dispositivo…” e inquadra il codice QR con la fotocamera."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MacでPilothouseを開いて「新しいデバイスをペアリング…」を選択し、カメラをQRコードに向けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 Pilothouse를 열고 ‘새로운 기기 페어링…’을 선택한 다음 카메라를 QR 코드에 대십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Pilothouse no seu Mac, escolha “Emparelhar Novo Dispositivo…” e aponte a câmera para o código QR."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inizde Pilothouse'u açın, “Yeni Cihaz Eşleştir…”i seçin ve kamerayı QR koda tutun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上打开 Pilothouse，选择“配对新设备…”，然后将相机对准二维码。"
          }
        }
      }
    },
    "Open Settings": {
      "localizations": {
        "de": {
          "stringUnit": {
