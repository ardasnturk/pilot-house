{
  "sourceLanguage": "en",
  "strings": {
    "%@ does not report its commands to Pilothouse.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ meldet seine Befehle nicht an Pilothouse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no informa de sus comandos a Pilothouse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne communique pas ses commandes à Pilothouse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non comunica i suoi comandi a Pilothouse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はコマンドをPilothouseに通知しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Pilothouse에 명령을 보고하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não informa seus comandos ao Pilothouse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ komutlarını Pilothouse'a bildirmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不会向 Pilothouse 报告其命令。"
          }
        }
      }
    },
    "%@ is not signed in on your Mac. Run it once in Terminal there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist auf deinem Mac nicht angemeldet. Starte es dort einmal im Terminal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no ha iniciado sesión en tu Mac. Ejecútalo una vez allí en Terminal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas connecté sur votre Mac. Lancez-le une fois dans Terminal sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non ha effettuato l’accesso sul tuo Mac. Avvialo una volta lì nel Terminale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はMacでサインインしていません。Macのターミナルで一度実行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 %@에 로그인되어 있지 않습니다. Mac의 터미널에서 한 번 실행하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ não tem sessão iniciada no seu Mac. Execute-o uma vez no Terminal do Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde oturum açmamış. Orada Terminal'de bir kez çalıştırın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未在你的 Mac 上登录。请在 Mac 的“终端”中运行一次。"
          }
        }
      }
    },
    "%@ runs on your Mac. You'll see every step here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ läuft auf deinem Mac. Du siehst hier jeden Schritt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ejecuta en tu Mac. Aquí verás cada paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’exécute sur votre Mac. Vous verrez chaque étape ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ viene eseguito sul tuo Mac. Qui vedrai ogni passaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はMac上で動作します。すべてのステップをここで確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) Mac에서 실행됩니다. 모든 단계를 여기에서 확인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é executado no seu Mac. Você verá cada etapa aqui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Mac'inizde çalışır. Her adımı burada görürsünüz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 在你的 Mac 上运行。你可以在这里看到每一步。"
          }
        }
      }
    },
