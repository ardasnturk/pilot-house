            "value": "Pilothouse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse"
          }
        }
      }
    },
    "Pilothouse always connects over your Wi-Fi first. Turn this on only if you also use Tailscale, to reach your Mac when you are away from that Wi-Fi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse verbindet sich immer zuerst über dein WLAN. Aktiviere das nur, wenn du auch Tailscale nutzt, um deinen Mac außerhalb dieses WLANs zu erreichen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse siempre se conecta primero por tu Wi-Fi. Activa esto solo si también usas Tailscale, para acceder a tu Mac cuando estés lejos de esa Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse se connecte toujours d’abord via votre Wi-Fi. N’activez cette option que si vous utilisez aussi Tailscale, pour joindre votre Mac lorsque vous êtes loin de ce Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse si connette sempre prima tramite la tua rete Wi-Fi. Attiva questa opzione solo se usi anche Tailscale, per raggiungere il tuo Mac quando sei lontano da quella rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseは常にまずWi-Fi経由で接続します。そのWi-Fiから離れているときにMacにアクセスするためにTailscaleも使用している場合のみ、オンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse는 항상 Wi-Fi를 통해 먼저 연결합니다. Tailscale도 사용하여 해당 Wi-Fi 밖에서 Mac에 연결하려는 경우에만 이 옵션을 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse sempre se conecta primeiro pela sua rede Wi-Fi. Ative esta opção apenas se você também usa o Tailscale, para acessar o seu Mac quando estiver longe dessa rede Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse her zaman önce Wi-Fi'niz üzerinden bağlanır. Bunu yalnızca Tailscale da kullanıyorsanız, o Wi-Fi'den uzaktayken Mac'inize ulaşmak için açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 始终优先通过无线局域网连接。仅当你也使用 Tailscale、需要在离开该无线局域网时连接 Mac 时，才打开此选项。"
          }
        }
      }
    },
    "Pilothouse could not access the Keychain: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse konnte nicht auf den Schlüsselbund zugreifen: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse no ha podido acceder al llavero: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse n’a pas pu accéder au trousseau : %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse non è riuscito ad accedere al portachiavi: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseはキーチェーンにアクセスできませんでした：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse가 키체인에 접근할 수 없습니다: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse não conseguiu acessar as Chaves: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse Anahtar Zinciri'ne erişemedi: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 无法访问钥匙串：%@"
          }
        }
      }
    },
    "Pilothouse follows your iPhone's language. To use another one just for Pilothouse, choose it in Settings → Apps → Pilothouse → Language.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse folgt der Sprache deines iPhone. Um nur für Pilothouse eine andere zu verwenden, wähle sie unter Einstellungen → Apps → Pilothouse → Sprache."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse sigue el idioma de tu iPhone. Para usar otro solo en Pilothouse, elígelo en Ajustes → Apps → Pilothouse → Idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse suit la langue de votre iPhone. Pour en utiliser une autre uniquement dans Pilothouse, choisissez-la dans Réglages → Apps → Pilothouse → Langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse segue la lingua del tuo iPhone. Per usarne un’altra solo per Pilothouse, sceglila in Impostazioni → App → Pilothouse → Lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PilothouseはiPhoneの言語に従います。Pilothouseだけ別の言語を使用するには、設定 → アプリ → Pilothouse → 言語で選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse는 iPhone의 언어를 따릅니다. Pilothouse에서만 다른 언어를 사용하려면 설정 → 앱 → Pilothouse → 언어에서 선택하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse segue o idioma do seu iPhone. Para usar outro idioma apenas no Pilothouse, escolha-o em Ajustes → Apps → Pilothouse → Idioma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse, iPhone'unuzun dilini kullanır. Yalnızca Pilothouse için başka bir dil kullanmak isterseniz Ayarlar → Uygulamalar → Pilothouse → Dil bölümünden seçin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 跟随 iPhone 的语言。若要仅为 Pilothouse 使用其他语言，请在“设置”→“App”→ Pilothouse →“语言”中选择。"
          }
        }
      }
    },
    "Pilothouse is not allowed to use the local network, so it cannot reach your Mac on this Wi-Fi. Turn on Local Network for Pilothouse in Settings, then try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse darf das lokale Netzwerk nicht verwenden und erreicht deinen Mac in diesem WLAN deshalb nicht. Aktiviere „Lokales Netzwerk“ für Pilothouse in den Einstellungen und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse no tiene permiso para usar la red local, así que no puede acceder a tu Mac en esta Wi-Fi. Activa Red local para Pilothouse en Ajustes y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse n’est pas autorisé à utiliser le réseau local et ne peut donc pas joindre votre Mac sur ce Wi-Fi. Activez Réseau local pour Pilothouse dans Réglages, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse non è autorizzato a usare la rete locale, quindi non può raggiungere il tuo Mac su questa rete Wi-Fi. Attiva Rete locale per Pilothouse in Impostazioni, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseにはローカルネットワークの使用が許可されていないため、このWi-FiでMacに接続できません。設定でPilothouseのローカルネットワークをオンにしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse에 로컬 네트워크 사용이 허용되지 않아 이 Wi-Fi에서 Mac에 연결할 수 없습니다. 설정에서 Pilothouse의 로컬 네트워크를 켠 다음 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse não tem permissão para usar a rede local, então não consegue acessar o seu Mac nesta rede Wi-Fi. Ative Rede Local para o Pilothouse em Ajustes e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse'un yerel ağı kullanma izni yok, bu yüzden bu Wi-Fi'de Mac'inize ulaşamıyor. Ayarlar'da Pilothouse için Yerel Ağ'ı açıp tekrar deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 未被允许使用本地网络，因此无法在此无线局域网中连接你的 Mac。请在“设置”中为 Pilothouse 打开“本地网络”，然后重试。"
          }
        }
      }
    },
    "Pilothouse learns your Mac's Tailscale address automatically and uses it whenever the local network is not available.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse lernt die Tailscale-Adresse deines Macs automatisch und nutzt sie, wenn das lokale Netzwerk nicht verfügbar ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse obtiene automáticamente la dirección de Tailscale de tu Mac y la usa cuando la red local no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse apprend automatiquement l’adresse Tailscale de votre Mac et l’utilise lorsque le réseau local n’est pas disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse rileva automaticamente l’indirizzo Tailscale del tuo Mac e lo usa quando la rete locale non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PilothouseはMacのTailscaleアドレスを自動的に取得し、ローカルネットワークが利用できないときに使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse는 Mac의 Tailscale 주소를 자동으로 파악하고 로컬 네트워크를 사용할 수 없을 때마다 이 주소를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse obtém o endereço do Tailscale do seu Mac automaticamente e o usa sempre que a rede local não estiver disponível."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse, Mac'inizin Tailscale adresini otomatik öğrenir ve yerel ağ kullanılamadığında bu adresi kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 会自动获取你 Mac 的 Tailscale 地址，并在本地网络不可用时使用它。"
          }
        }
      }
    },
    "Pilothouse may not use the local network. Turn on Local Network for Pilothouse in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse darf das lokale Netzwerk nicht verwenden. Aktiviere „Lokales Netzwerk“ für Pilothouse in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse no puede usar la red local. Activa Red local para Pilothouse en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse ne peut pas utiliser le réseau local. Activez Réseau local pour Pilothouse dans Réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse non può usare la rete locale. Attiva Rete locale per Pilothouse in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseはローカルネットワークを使用できません。設定でPilothouseのローカルネットワークをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse가 로컬 네트워크를 사용할 수 없습니다. 설정에서 Pilothouse의 로컬 네트워크를 켜십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse não pode usar a rede local. Ative Rede Local para o Pilothouse em Ajustes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse'un yerel ağı kullanma izni yok. Ayarlar'da Pilothouse için Yerel Ağ'ı açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 无法使用本地网络。请在“设置”中为 Pilothouse 打开“本地网络”。"
          }
        }
      }
    },
    "Pilothouse uses no third-party libraries. Encryption is provided by Apple CryptoKit and follows the public-domain Noise Protocol Framework specification.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse verwendet keine Bibliotheken von Drittanbietern. Die Verschlüsselung stammt aus Apple CryptoKit und folgt der gemeinfreien Spezifikation des Noise Protocol Framework."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse no usa bibliotecas de terceros. El cifrado lo proporciona Apple CryptoKit y sigue la especificación de dominio público del Noise Protocol Framework."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse n’utilise aucune bibliothèque tierce. Le chiffrement est fourni par Apple CryptoKit et suit la spécification du Noise Protocol Framework, qui relève du domaine public."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse non usa librerie di terze parti. La crittografia è fornita da Apple CryptoKit e segue la specifica di pubblico dominio del Noise Protocol Framework."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouseはサードパーティ製ライブラリを使用していません。暗号化はApple CryptoKitによって提供され、パブリックドメインのNoise Protocol Framework仕様に準拠しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse는 타사 라이브러리를 사용하지 않습니다. 암호화는 Apple CryptoKit으로 제공되며 퍼블릭 도메인인 Noise Protocol Framework 사양을 따릅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse não usa bibliotecas de terceiros. A criptografia é fornecida pelo Apple CryptoKit e segue a especificação Noise Protocol Framework, de domínio público."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse üçüncü taraf kütüphane kullanmaz. Şifreleme Apple CryptoKit ile sağlanır ve kamu malı Noise Protocol Framework belirtimini izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 不使用任何第三方库。加密由 Apple CryptoKit 提供，并遵循公有领域的 Noise Protocol Framework 规范。"
          }
        }
      }
    },
    "Pilothouse was restarted while Claude was working; the last turn may be incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse wurde neu gestartet, während Claude arbeitete; die letzte Runde ist eventuell unvollständig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse se reinició mientras Claude trabajaba; puede que el último turno esté incompleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse a redémarré pendant que Claude travaillait ; le dernier tour est peut-être incomplet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse è stato riavviato mentre Claude lavorava; l’ultimo turno potrebbe essere incompleto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeの作業中にPilothouseが再起動されました。最後のターンが不完全な可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude가 작업하는 동안 Pilothouse가 재시작되었습니다. 마지막 턴이 완료되지 않았을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse foi reiniciado enquanto o Claude trabalhava; o último turno pode estar incompleto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude çalışırken Pilothouse yeniden başlatıldı; son tur eksik olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude 工作期间 Pilothouse 已重新启动；最后一轮可能不完整。"
          }
        }
      }
    },
    "Pilothouse works with Claude Code. It is an independent open-source project and is not affiliated with Anthropic. Pilothouse collects no data.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse funktioniert mit Claude Code. Es ist ein unabhängiges Open-Source-Projekt und steht in keiner Verbindung zu Anthropic. Pilothouse sammelt keine Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse funciona con Claude Code. Es un proyecto independiente de código abierto y no está afiliado a Anthropic. Pilothouse no recopila datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse fonctionne avec Claude Code. C’est un projet open source indépendant, sans lien avec Anthropic. Pilothouse ne collecte aucune donnée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse funziona con Claude Code. È un progetto open source indipendente e non è affiliato ad Anthropic. Pilothouse non raccoglie dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PilothouseはClaude Codeと連携して動作します。独立したオープンソースプロジェクトであり、Anthropicとは提携していません。Pilothouseはデータを収集しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse는 Claude Code와 함께 작동합니다. 독립적인 오픈 소스 프로젝트이며 Anthropic과 제휴 관계가 없습니다. Pilothouse는 데이터를 수집하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pilothouse funciona com o Claude Code. É um projeto independente de código aberto e não é afiliado à Anthropic. O Pilothouse não coleta dados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse, Claude Code ile çalışır. Bağımsız, açık kaynaklı bir projedir ve Anthropic ile bağlantılı değildir. Pilothouse hiçbir veri toplamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse 与 Claude Code 配合使用。它是一个独立的开源项目，与 Anthropic 无关联。Pilothouse 不收集任何数据。"
          }
        }
      }
    },
    "Plan only": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur planen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo planificar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Planifier uniquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo pianificazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "計画のみ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계획만"
          }
