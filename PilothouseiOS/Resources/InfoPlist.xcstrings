    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse verwendet die Kamera nur, um den Kopplungs-QR-Code von Pilothouse auf deinem Mac zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse uses the camera only to scan the pairing QR code shown by Pilothouse on your Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse, kamerayı yalnızca Mac'inizdeki Pilothouse'un gösterdiği eşleştirme QR kodunu taramak için kullanır."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse verbindet sich im lokalen Netzwerk mit deinem Mac, um deine Claude-Code-Sitzungen zu steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse connects to your Mac on the local network to control your Claude Code sessions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilothouse, Claude Code oturumlarınızı yönetmek için yerel ağdaki Mac'inize bağlanır."
          }
        }
      }
    }
  },
  "version": "1.0"
}
